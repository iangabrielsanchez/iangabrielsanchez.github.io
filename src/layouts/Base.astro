---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/tailwind.css';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/about.html" — resolved against the site origin. */
  canonical: string;
  active?: 'about' | 'products' | 'lab' | 'blog' | 'portfolio';
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  active,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://iangabrielsanchez.com');
const pageUrl = new URL(canonical, site).href;
const ogImage = new URL('/assets/og-image.jpg', site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-white text-black font-sans min-h-screen flex flex-col">
    <div class="max-w-[1400px] w-full mx-auto flex flex-col flex-1 bg-white">
      <Nav active={active} />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "3e1fa82d8d834b08b9a40b8997eb6398"}'></script>
  </body>
</html>
