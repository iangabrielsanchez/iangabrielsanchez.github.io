---
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
---

<Base
  title={`${p.title} — Ian Gabriel Sanchez`}
  description={p.description}
  canonical={`/portfolio/${project.id}`}
  active="portfolio"
  ogType="article"
>
  <div class="border-b-3 border-black bg-white">
    <div class="px-10 py-4">
      <a href="/portfolio" class="text-[10px] font-bold uppercase tracking-[.08em] text-gray-400 hover:text-black transition-colors">← Portfolio</a>
    </div>
  </div>

  <div class="border-b-3 border-black bg-white">
    <div class="px-10 pt-14 pb-10 max-w-3xl">
      <p class="text-[10px] font-bold text-accent uppercase tracking-widest2 mb-3">{p.category}</p>
      <h1 class="text-[clamp(32px,4.5vw,52px)] font-black uppercase leading-none tracking-[-0.02em] mb-4">{p.title}</h1>
      <div class="flex flex-wrap gap-2">
        {p.tags.map((tag: string) => (
          <span class="text-[9px] font-bold uppercase tracking-[.1em] border border-gray-300 text-gray-500 px-2 py-0.5">{tag}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="border-b-3 border-black">
    <div class="px-10 py-14">
      <div class="prose max-w-3xl">
        <Content />
      </div>
    </div>
  </div>
</Base>

<Lightbox />
