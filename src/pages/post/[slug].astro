---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { categorySlug } from '../../lib/blog';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const p = post.data;
const { Content } = await render(post);
---

<Base
  title={`${p.title} — Ian Gabriel Sanchez`}
  description={p.description}
  canonical={`/post/${post.id}`}
  active="blog"
  ogType="article"
>
  <div class="border-b-3 border-black bg-white">
    <div class="px-10 py-4">
      <a href="/blog" class="text-[10px] font-bold uppercase tracking-[.08em] text-gray-400 hover:text-black transition-colors">← Blog</a>
    </div>
  </div>

  <div class="border-b-3 border-black bg-white">
    <div class="px-10 pt-14 pb-10 max-w-3xl">
      <a href={`/blog/category/${categorySlug(p.category)}`} class="text-[10px] font-bold text-accent uppercase tracking-widest2 mb-3 inline-block">{p.category}</a>
      <h1 class="text-[clamp(32px,4.5vw,52px)] font-black uppercase leading-none tracking-[-0.02em] mb-4">{p.title}</h1>
      <p class="text-[13px] text-gray-400 font-semibold">{p.date}</p>
    </div>
  </div>

  <div class="border-b-3 border-black">
    <div class="px-10 py-14">
      <div class="prose max-w-2xl">
        <Content />
      </div>
    </div>
  </div>
</Base>
