---
import Base from '../layouts/Base.astro';
import BlogList from '../components/BlogList.astro';
import { getCollection } from 'astro:content';
import { categorySlug } from '../lib/blog';

const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
const categories = [...new Set(posts.map((p) => p.data.category))].sort();
---

<Base
  title="Blog — Ian Gabriel Sanchez"
  description="Writing on backend engineering, infrastructure, and security by Ian Gabriel Sanchez."
  canonical="/blog"
  active="blog"
>
  <!-- ── PAGE HEADER ── -->
  <div class="border-b-3 border-black bg-white">
    <div class="px-10 pt-14 pb-10">
      <p class="text-[10px] font-bold text-accent uppercase tracking-widest2 mb-3">Writing</p>
      <h1 class="text-[clamp(48px,6vw,72px)] font-black uppercase leading-none tracking-[-0.03em]">Blog</h1>
    </div>
  </div>

  {posts.length === 0 ? (
    <div class="border-b-3 border-black">
      <div class="px-10 py-16 md:py-24 max-w-2xl">
        <p class="text-[10px] font-bold text-accent uppercase tracking-widest2 mb-5">Coming Soon</p>
        <h2 class="text-[clamp(32px,4vw,52px)] font-black uppercase leading-none tracking-[-0.02em] mb-6">
          Hold on.<br />Something good<br />is in the works.
        </h2>
        <p class="text-[14px] text-gray-500 leading-relaxed max-w-md mb-8">
          Writing on distributed systems, backend architecture, and the unglamorous details that actually matter in production. First posts are coming.
        </p>
        <a
          href="mailto:contact@iangabrielsanchez.com?subject=Blog%20notification"
          class="inline-block bg-black text-white text-[11px] font-bold uppercase tracking-[.06em] px-6 py-3 hover:bg-accent transition-colors"
        >
          Notify me when it's live →
        </a>
      </div>
    </div>
  ) : (
    <BlogList posts={posts} categories={categories} categorySlug={categorySlug} active={null} />
  )}
</Base>
