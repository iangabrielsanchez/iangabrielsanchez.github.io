{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio.html"
    },
    {
      "source": "/lab",
      "destination": "/lab.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/portfolio/:slug",
      "destination": "/portfolio-item.html"
    },
    {
      "source": "/post/:slug",
      "destination": "/post.html"
    },
    {
      "source": "/product/:slug",
      "destination": "/product.html"
    }
  ]
}